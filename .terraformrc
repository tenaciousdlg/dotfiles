# Terraform CLI configuration.
# https://developer.hashicorp.com/terraform/cli/config/config-file
#
# One shared provider cache instead of a full copy per working directory.
#
# Measured in ~/github on 2026-09-27: 195 provider binaries across ~60
# .terraform/ dirs, but only 45 distinct provider+version combinations,
# worth 6.8 GB. hashicorp/aws 5.100.0 alone existed 23 times. The other
# ~28 GB was duplication.
#
# Terraform uses symlinks out of this cache where it can, so the saving
# persists across inits rather than being a one-off.
#
# Caveats, straight from the doc above, all of which apply here:
#   - Terraform NEVER deletes anything from this directory. Old provider
#     versions accumulate and have to be pruned by hand.
#   - The cache is not guaranteed concurrency safe. Do not run two inits
#     against it at the same time.
#   - It must not also be a configured or implied filesystem mirror dir.
#   - By default a cached package is only used when it matches the
#     dependency lock file checksums, which is what we want. Do not reach
#     for plugin_cache_may_break_dependency_lock_file.
plugin_cache_dir = "$HOME/.terraform.d/plugin-cache"
