# myhelp: list your own aliases, functions and scripts, read from the files that define them.
#
#   myhelp            everything, grouped by where it is defined
#   myhelp tf         only entries whose name or description matches "tf"
#   myhelp --vault    also write the list to the vault as a generated note
#
# The files are the record; this only reads them, so it cannot drift. To give
# an entry a description, put a `# one line` comment directly above its
# definition (the first line of that comment block is shown), or a trailing
# `# comment` on an alias. Scripts in dotfiles/bin use their first comment
# line after the shebang. Names starting with `_` are internal and skipped.

_myhelp_scan() {
  # $1 = file; prints: kind<TAB>name<TAB>description
  awk '
    function flush() { blk = ""; }
    /^[[:space:]]*#/ {
      line = $0; sub(/^[[:space:]]*#+[[:space:]]?/, "", line)
      if (blk == "" && line != "") blk = line
      next
    }
    /^[[:space:]]*$/ { flush(); next }
    /^[[:space:]]*alias [A-Za-z0-9_.-]+=/ {
      l = $0; sub(/^[[:space:]]*alias /, "", l)
      name = l; sub(/=.*/, "", name)
      val = l; sub(/^[^=]*=/, "", val)
      desc = ""
      if (match(val, /[[:space:]]#[[:space:]]?/)) { desc = substr(val, RSTART + RLENGTH); val = substr(val, 1, RSTART - 1) }
      # aliases show their expansion: a section header above them says less
      if (desc == "") { gsub(/^["\x27]|["\x27][[:space:]]*$/, "", val); desc = "= " val }
      if (name !~ /^_/) printf "alias\t%s\t%s\n", name, desc
      flush(); next
    }
    /^(function[[:space:]]+)?[A-Za-z][A-Za-z0-9_.-]*[[:space:]]*\(\)[[:space:]]*\{?/ {
      # column 0 only: indented matches are code inside a function, e.g. awk
      l = $0; sub(/^(function[[:space:]]+)?/, "", l); name = l; sub(/[[:space:]]*\(.*/, "", name)
      if (name !~ /^_/ && name != "") printf "func\t%s\t%s\n", name, (blk != "" ? blk : (hdr != "" ? hdr : "(no description: add a # comment above it)"))
      flush(); next
    }
    { flush() }
  ' hdr="$2" "$1"
}

_myhelp_header() {
  # first meaningful comment line of a file, used when a function has none of its own
  awk 'NR==1 && /^#!/ {next} /^[[:space:]]*#/ {l=$0; sub(/^[[:space:]]*#+[[:space:]]?/,"",l); if (l!="") {print l; exit}} /^[^#[:space:]]/ {exit}' "$1"
}

myhelp() {
  emulate -L zsh
  setopt extended_glob
  local vault=0 pat=""
  for a in "$@"; do [[ $a == --vault ]] && vault=1 || pat=$a; done

  local df=${DOTFILES:-$HOME/github/dotfiles} tz=$HOME/github/teleport-zsh
  local -a rows; local f kind name desc grp

  _myhelp_add() {  # $1 = group, $2 = file
    local h; h=$(_myhelp_header "$2")
    local r; for r in "${(@f)$(_myhelp_scan "$2" "$h")}"; do [[ -n $r ]] && rows+=("$1	$r"); done
  }

  [[ -f $df/.aliases ]] && _myhelp_add "dotfiles/.aliases" $df/.aliases
  for f in $df/functions/*.zsh(N); do _myhelp_add "dotfiles/functions" $f; done
  for f in $df/bin/*(N.); do
    desc=$(awk 'NR==1 && /^#!/ {next} /^#/ {l=$0; sub(/^#+[[:space:]]?/,"",l); if (l!="") {print l; exit}}' $f)
    rows+=("dotfiles/bin (in ~/bin)	script	${f:t}	${desc:-(no description)}")
  done
  for f in $tz/lib/*.zsh(N); do _myhelp_add "teleport-zsh" $f; done
  if [[ -f $HOME/.zshrc.local ]]; then
    _myhelp_add "~/.zshrc.local (this Mac only)" $HOME/.zshrc.local
    local k; for k in ${(ok)TELEPORT_ZSH_CLUSTERS}; do
      rows+=("~/.zshrc.local (this Mac only)	tlogin	$k	-> ${TELEPORT_ZSH_CLUSTERS[$k]}")
    done
  fi
  unfunction _myhelp_add

  [[ -n $pat ]] && rows=(${(M)rows:#*${~pat}*})

  local last="" w=$(( ${COLUMNS:-120} - 30 )); (( w < 40 )) && w=40
  local r
  for r in $rows; do
    grp=${r%%	*}; r=${r#*	}; kind=${r%%	*}; r=${r#*	}; name=${r%%	*}; desc=${r#*	}
    [[ $grp != $last ]] && { print -P "\n%B${grp}%b"; last=$grp; }
    printf "  %-18s %-6s %s\n" "$name" "$kind" "${desc[1,$w]}"
  done

  if (( vault )); then
    local out=$HOME/github/vault/notes/shell-commands.md
    {
      print -- "---\ntags: [shell, reference, generated]\n---\n"
      print -- "# Shell commands\n"
      print -- "GENERATED by \`myhelp --vault\` (dotfiles/functions/myhelp.zsh) on $(date '+%Y-%m-%d %H:%M'). Do not edit here: change the comment above the definition in the source file and regenerate.\n"
      last=""
      for r in $rows; do
        grp=${r%%	*}; r=${r#*	}; kind=${r%%	*}; r=${r#*	}; name=${r%%	*}; desc=${r#*	}
        [[ $grp != $last ]] && { print -- "\n## $grp\n\n| name | kind | description |\n|---|---|---|"; last=$grp; }
        print -- "| \`$name\` | $kind | ${desc//|/\\|} |"
      done
    } > $out
    print -P "\n%F{8}wrote ${out/#$HOME/~}%f"
  fi
}
