#!/usr/bin/env bash
# Global pre-commit hook (see core.hooksPath in .gitconfig) — scans staged
# changes for secrets before they ever get committed, across every repo,
# regardless of that repo's own .gitignore coverage.
#
# Two tiers, picked by the repo's origin remote:
#   private org remotes (globs in ~/.config/gitleaks/private-remotes)
#       → base.toml: secrets + account IDs; org names/hostnames are
#         legitimate in private org repos
#   everything else (public/personal repos, no remote)
#       → strict.toml: additionally blocks org identifiers, internal
#         hostnames, work emails — the dummy-names policy, enforced
#         mechanically
#
# All three files live in ~/.config/gitleaks/, OUTSIDE any repo, because
# the rules and remote patterns contain the sensitive literals themselves.
# Missing configs fall back to gitleaks defaults, so this degrades safely
# on a fresh machine.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "warning: gitleaks not installed — commit is NOT being scanned for secrets (brew install gitleaks)" >&2
  exit 0
fi

cfgdir="$HOME/.config/gitleaks"
remote="$(git remote get-url origin 2>/dev/null || true)"

tier="strict"
if [ -n "$remote" ] && [ -f "$cfgdir/private-remotes" ]; then
  while IFS= read -r pat; do
    [ -z "$pat" ] && continue
    # shellcheck disable=SC2254 — patterns are meant to glob
    case "$remote" in
      $pat) tier="base"; break ;;
    esac
  done < "$cfgdir/private-remotes"
fi

cfgargs=()
[ -f "$cfgdir/$tier.toml" ] && cfgargs=(--config "$cfgdir/$tier.toml")

# A merge's staged diff (against HEAD) carries everything the incoming
# branch brings, which is already committed elsewhere: merging a public
# main into a PR branch tripped strict on text that main already published.
# The only new content in a merge is ours plus the conflict resolutions,
# so scan the lines added relative to each incoming parent.
merge_head="$(git rev-parse --git-path MERGE_HEAD)"
if [ -f "$merge_head" ]; then
  rc=0
  while IFS= read -r parent; do
    [ -z "$parent" ] && continue
    git diff --cached --unified=0 --no-color "$parent" \
      | grep '^+' | grep -v '^+++' \
      | gitleaks stdin --verbose --redact "${cfgargs[@]}" || rc=$?
  done < "$merge_head"
  exit "$rc"
fi

gitleaks protect --staged --verbose --redact "${cfgargs[@]}"
